{
  "name": "layerlane-apply",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=web",
    "build:mcp": "npm run build --workspace=@layerlane/chq-mcp",
    "dev": "npm run dev --workspace=web",
    "dev:mcp": "npm run dev --workspace=@layerlane/chq-mcp",
    "lint": "npm run lint --workspace=web",
    "test:mcp": "npm run build:mcp && npm test --workspace=@layerlane/chq-mcp"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
