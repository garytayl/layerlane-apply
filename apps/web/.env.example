# =============================================================================
# layerlane-apply — Next.js web app
# =============================================================================
# Copy to .env.local in this directory (gitignored):
#   cp .env.example .env.local
#
# Vercel: Project → Settings → Environment Variables (same keys for Production).
# =============================================================================

# --- Supabase (Dashboard → Project Settings → API) ---

# Project URL (public).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon / public key (public; bundled for browser Supabase client).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (SECRET — server only). Used when validating API tokens from the
# browser extension and for service-role queries. Never expose in client code.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---

# Required for POST /api/jobs/[id]/analyze and dashboard “Re-analyze”.
OPENAI_API_KEY=

# --- App URL ---

# Site origin for auth callbacks and signup email redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enables the local /api/chq tool contract. Use a long random value; never commit it.
CHQ_TOOL_TOKEN=

# --- Career HQ external development bridge ---
# Local-only is the safe default. `npm run dev` also binds to 127.0.0.1.
CHQ_BRIDGE_MODE=local
CHQ_BRIDGE_REMOTE_ENABLED=false
CHQ_BRIDGE_RATE_LIMIT=60

# Optional short-lived bootstrap credential for local integration tests only.
# Persistent clients should be created and revoked from /local-ledger/bridge.
CHQ_BRIDGE_BOOTSTRAP_TOKEN=
CHQ_BRIDGE_BOOTSTRAP_EXPIRES_AT=

# Set to a long random value before remote mode so stored IP audit hashes cannot
# be correlated using the local development fallback salt.
CHQ_BRIDGE_AUDIT_SALT=
# Production: https://layerlane-apply.vercel.app
